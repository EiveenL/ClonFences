<Window x:Class="ClonFences.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración — Clon Fences" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13" Background="#FFF7F7F9">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="Foreground" Value="#FF1F2937" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,8,22,20">
        <TextBlock Text="Comportamiento" Style="{StaticResource Section}" />
        <CheckBox x:Name="QuickHideBox" Content="Doble clic en un hueco del escritorio para ocultar / mostrar todo" />
        <CheckBox x:Name="RightDragBox" Content="Clic derecho + arrastrar sobre el escritorio para dibujar un fence" />
        <CheckBox x:Name="HideIconsBox" Content="Ocultar los iconos de Windows (los fences muestran tus archivos)" />
        <CheckBox x:Name="AutoAddBox" Content="Colocar en un fence los elementos nuevos del escritorio" />
        <StackPanel Orientation="Horizontal" Margin="24,2,0,6">
            <TextBlock Text="Fence de destino:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF4B5563" />
            <ComboBox x:Name="DefaultFenceBox" Width="250" DisplayMemberPath="Title" />
        </StackPanel>
        <CheckBox x:Name="SnapBox" Content="Imantar los fences a los bordes de la pantalla y a otros fences" />
        <CheckBox x:Name="PeekBox" Content="Mostrar el contenido de un fence enrollado al pasar el ratón" />
        <CheckBox x:Name="LockAllBox" Content="Bloquear la posición y el tamaño de todos los fences" />
        <CheckBox x:Name="StartupBox" Content="Iniciar Clon Fences con Windows" />

        <TextBlock Text="Apariencia predeterminada" Style="{StaticResource Section}" />
        <CheckBox x:Name="BlurBox" Content="Desenfocar el fondo detrás de los fences" />

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Color de fondo:" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border x:Name="ColorSwatch" Width="34" Height="22" CornerRadius="4" BorderBrush="#40000000" BorderThickness="1" />
                <Button Content="Cambiar…" Margin="10,0,0,0" Padding="12,3" Click="PickColor_Click" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Opacidad:" VerticalAlignment="Center" Margin="0,12,0,0" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                <Slider x:Name="OpacitySlider" Width="260" Minimum="0" Maximum="100" TickFrequency="5"
                        IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged" />
                <TextBlock x:Name="OpacityText" Width="50" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Tamaño de iconos:" VerticalAlignment="Center" Margin="0,12,0,0" />
            <ComboBox x:Name="IconSizeBox" Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,12,0,0" />
        </Grid>

        <CheckBox x:Name="ApplyAllBox" Margin="0,14,0,0"
                  Content="Aplicar también a los fences con color/opacidad/iconos personalizados" />

        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#FF6B7280" FontSize="12">
            Consejos: doble clic en el título enrolla un fence · arrastra el título para moverlo · arrastra los bordes para
            redimensionarlo · clic derecho en un elemento muestra el menú de Windows.
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Guardar" IsDefault="True" Width="100" Padding="0,5" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="Cancelar" IsCancel="True" Width="100" Padding="0,5" />
        </StackPanel>
    </StackPanel>
</Window>
