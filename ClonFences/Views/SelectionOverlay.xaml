<Window x:Class="ClonFences.Views.SelectionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo fence"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        Left="-20000" Top="-20000" Width="10" Height="10">
    <Border BorderThickness="2" BorderBrush="#E060A5FA" Background="#3360A5FA" CornerRadius="6">
        <TextBlock Text="Nuevo fence" Foreground="White" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.8" />
            </TextBlock.Effect>
        </TextBlock>
    </Border>
</Window>
