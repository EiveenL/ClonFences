<Window x:Class="ClonFences.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clon Fences" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="True" FontFamily="Segoe UI" FontSize="13" Background="#FFF7F7F9">
    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="InputBox" Padding="5,4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Aceptar" IsDefault="True" Width="96" Padding="0,5" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Cancelar" IsCancel="True" Width="96" Padding="0,5" />
        </StackPanel>
    </StackPanel>
</Window>
