<Window x:Class="ClonFences.Views.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fence"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Foreground="White"
        Width="360" Height="240"
        DragEnter="Window_DragOver"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseRightButtonUp="Window_MouseRightButtonUp">

    <Window.Resources>
        <!-- Barra de desplazamiento fina -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#70FFFFFF" Margin="0,2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="4" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent" Padding="2,5,2,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#45FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#70FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlyphButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Width="22" Height="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fondo casi transparente para que toda la ventana reciba clics (ventanas en capas) -->
    <Grid x:Name="Root" Background="#01000000">
        <Border x:Name="Frame" CornerRadius="6" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="TitleBar" Grid.Row="0" CornerRadius="5,5,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PortalGlyph" Grid.Column="0" Text="&#xE8B7;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.8" Visibility="Collapsed" />
                        <Button x:Name="BackButton" Grid.Column="0" Content="&#xE72B;" ToolTip="Atrás"
                                Style="{StaticResource GlyphButton}" Visibility="Collapsed" Click="BackButton_Click" />

                        <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="{DynamicResource ShadowOpacity}" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBox x:Name="TitleEditor" Grid.Column="1" Visibility="Collapsed"
                                 FontSize="13" FontWeight="SemiBold" HorizontalContentAlignment="Center"
                                 VerticalAlignment="Center" Padding="2,1" BorderThickness="1"
                                 Background="#E6FFFFFF" Foreground="#FF1A1A1A"
                                 KeyDown="TitleEditor_KeyDown" LostKeyboardFocus="TitleEditor_LostKeyboardFocus" />

                        <TextBlock x:Name="LockGlyph" Grid.Column="2" Text="&#xE72E;" ToolTip="Fence bloqueado"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.7" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <ListBox x:Name="ItemsList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0" Padding="4,2,2,4"
                         SelectionMode="Extended"
                         ItemContainerStyle="{StaticResource TileStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         KeyboardNavigation.TabNavigation="Once"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="ItemsList_PreviewMouseLeftButtonUp"
                         PreviewMouseMove="ItemsList_PreviewMouseMove"
                         PreviewMouseRightButtonUp="ItemsList_PreviewMouseRightButtonUp">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="{DynamicResource TileWidth}" ToolTip="{Binding ToolTipText}"
                                        ToolTipService.InitialShowDelay="900">
                                <Image Source="{Binding Icon}" Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                       HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center" FontSize="12" MaxHeight="33" Margin="1,4,1,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="{DynamicResource ShadowOpacity}" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="Arrastra archivos aquí"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="12" Opacity="0.65" FontSize="12"
                           IsHitTestVisible="False" Visibility="Collapsed" />
            </Grid>
        </Border>

        <Border x:Name="DropHighlight" CornerRadius="6" BorderThickness="2"
                BorderBrush="#CC60A5FA" Background="#2260A5FA"
                IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
</Window>
