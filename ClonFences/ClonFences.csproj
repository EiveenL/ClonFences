<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ClonFences</AssemblyName>
    <RootNamespace>ClonFences</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Clon Fences</Product>
    <Description>Organizador de escritorio inspirado en Stardock Fences</Description>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <!-- WPF necesita el manifiesto PerMonitorV2; el aviso de WinForms no aplica -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="ClonFences.app.ico" />
  </ItemGroup>

</Project>
